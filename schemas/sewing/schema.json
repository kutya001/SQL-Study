        { "name": "Kind", "type": "nvarchar(20)", "desc": "Вид работ: Раскрой, Пошив, ВТО и упаковка" },
        { "name": "City", "type": "nvarchar(30)", "desc": "Город" },
        { "name": "LinesCount", "type": "int", "desc": "Число производственных линий" },
        { "name": "OpenDate", "type": "date", "desc": "Дата открытия" }
      ]
    },
    {

        { "name": "CustomerType", "type": "nvarchar(20)", "desc": "Тип: Розничная сеть, Оптовик, Маркетплейс, Экспорт, Госзаказ, Корпоративный" },
        { "name": "Country", "type": "nvarchar(20)", "desc": "Страна" },

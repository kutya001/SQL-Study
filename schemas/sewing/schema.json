        { "name": "WorkshopID", "type": "int", "fk": "Workshops.WorkshopID", "desc": "Цех" },
        { "name": "EmployeeID", "type": "int", "fk": "Employees.EmployeeID", "desc": "Швея" },
        { "name": "ProductID", "type": "int", "fk": "Products.ProductID", "desc": "Модель" },
        { "name": "OrderLineID", "type": "int", "fk": "OrderLines.OrderLineID", "desc": "Строка заказа (NULL — пошив на склад)" },
        { "name": "Shift", "type": "nvarchar(10)", "desc": "Смена: Дневная или Вечерняя" },
        { "name": "QtyMade", "type": "int", "desc": "Пошито изделий в партии" },
        { "name": "QtyDefect", "type": "int", "desc": "Из них забраковано ОТК" }

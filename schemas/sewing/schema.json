        { "name": "FullName", "type": "nvarchar(100)", "desc": "Фамилия и имя" },
        { "name": "WorkshopID", "type": "int", "fk": "Workshops.WorkshopID", "desc": "Цех (NULL — администрация)" },
        { "name": "Position", "type": "nvarchar(30)", "desc": "Должность" },

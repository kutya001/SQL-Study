        { "name": "CostPrice", "type": "decimal(12,2)", "desc": "Плановая себестоимость изделия, сом" },
        { "name": "WholesalePrice", "type": "decimal(12,2)", "desc": "Текущая оптовая цена, сом" },
        { "name": "IsActive", "type": "bit", "desc": "1 — модель в производстве, 0 — снята" },
        { "name": "LaunchDate", "type": "date", "desc": "Дата запуска модели" }
      ]
    },
    {

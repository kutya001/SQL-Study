        { "name": "Season", "type": "nvarchar(20)", "desc": "Сезон: Весна-лето, Осень-зима, Всесезон" },
        { "name": "PlanDefectPct", "type": "decimal(4,2)", "desc": "Допустимый процент брака по нормативу" }
      ]
    },
    {
      "name": "Products", "title": "Модели (артикулы)",
      "columns": [
        { "name": "ProductID", "type": "int", "pk": true, "desc": "Код модели" },
        { "name": "Article", "type": "varchar(10)", "desc": "Артикул: префикс группы и номер, например FT-101" },
        { "name": "ProductName", "type": "nvarchar(100)", "desc": "Название модели" },
        { "name": "GroupID", "type": "int", "fk": "ProductGroups.GroupID", "desc": "Ассортиментная группа" },
        { "name": "Fabric", "type": "nvarchar(30)", "desc": "Основная ткань" },

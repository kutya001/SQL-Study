        { "name": "ContractDate", "type": "date", "desc": "Дата договора" }
      ]
    },
    {
      "name": "Orders", "title": "Заказы",
      "columns": [
        { "name": "OrderID", "type": "int", "pk": true, "desc": "Номер заказа" },
        { "name": "OrderDate", "type": "date", "desc": "Дата заказа" },
        { "name": "CustomerID", "type": "int", "fk": "Customers.CustomerID", "desc": "Заказчик" },
        { "name": "DueDate", "type": "date", "desc": "Срок отгрузки по договору" },
        { "name": "ShipDate", "type": "date", "desc": "Фактическая дата отгрузки (NULL — ещё не отгружен)" },

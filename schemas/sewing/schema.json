        { "name": "Qty", "type": "int", "desc": "Заказано, шт" },
        { "name": "Price", "type": "decimal(12,2)", "desc": "Цена за штуку в заказе, сом" }
      ]
    },
    {
      "name": "ProductionLog", "title": "Журнал выпуска (партии, сданные в ОТК)",
      "columns": [
